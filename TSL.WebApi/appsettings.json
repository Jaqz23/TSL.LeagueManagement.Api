{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR-SERVER;Database=DB-NAME;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=True;",
    "IdentityConnection": "Server=YOUR-SERVER;Database=DB-NAME;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200",
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },
  "Jwt": {
    "Key": "TSL_Key",
    "Issuer": "TSL.WebAPI",
    "Audience": "TSL.Client",
    "DurationInMinutes": 120,
    "RefreshTokenDurationInDays": 7,
    "ValidateLifetime": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateIssuerSigningKey": true,
    "ClockSkewInMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}